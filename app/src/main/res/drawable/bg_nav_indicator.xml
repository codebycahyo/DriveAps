<?xml version="1.0" encoding="utf-8"?>
<!-- Active nav item pill indicator: centered around icon+label, narrower than the full
     column so it reads as an indicator rather than a filled tab. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nav_item_selected_bg" />
    <corners android:radius="@dimen/radius_pill" />
</shape>
