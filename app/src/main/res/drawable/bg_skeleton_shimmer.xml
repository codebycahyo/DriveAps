<?xml version="1.0" encoding="utf-8"?>
<!-- Shimmer sheen: a soft highlight band over the skeleton base. Animate this
     view's translationX (see res/anim/shimmer_sweep.xml) for a moving shimmer,
     or fade its alpha for a lightweight pulse. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@android:color/transparent"
        android:centerColor="@color/skeleton_highlight"
        android:endColor="@android:color/transparent" />
    <corners android:radius="@dimen/radius_xs" />
</shape>
