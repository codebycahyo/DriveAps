<?xml version="1.0" encoding="utf-8"?>
<!-- Floating dock: fully-rounded (pill) rectangle, matching the Figma "Floating Bar"
     cornerRadius. Replaces the old shape="oval" background, which rendered as a
     malformed lens when stretched to bar width. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_dock_bg" />
    <corners android:radius="@dimen/bottom_nav_corner" />
    <stroke
        android:width="@dimen/stroke_thin"
        android:color="@color/glass_highlight" />
</shape>
