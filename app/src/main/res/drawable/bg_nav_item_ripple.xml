<?xml version="1.0" encoding="utf-8"?>
<!-- Bounded, rounded ripple for a bottom-nav tab. Replaces the unbounded
     selectableItemBackgroundBorderless whose ripple spilled outside the
     rounded floating dock. Inset so the highlight sits neatly inside each
     tab cell and reads like an M3 navigation indicator. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/spacing_8"
    android:insetRight="@dimen/spacing_8"
    android:insetTop="@dimen/spacing_4"
    android:insetBottom="@dimen/spacing_4">
    <ripple android:color="@color/glass_overlay_light">
        <item android:id="@android:id/mask">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/white" />
                <corners android:radius="@dimen/radius_large" />
            </shape>
        </item>
    </ripple>
</inset>
