<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_white"
    android:fillViewport="true"
    tools:context=".ui.login.LoginFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_24"
        android:paddingBottom="@dimen/spacing_24">

        <!-- Header: Logo & Brand -->
        <LinearLayout
            android:id="@+id/headerBrand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="@dimen/logo_size"
                android:layout_height="@dimen/logo_size"
                android:background="@drawable/bg_badge_rounded">

                <ImageView
                    android:layout_width="@dimen/icon_size_xlarge"
                    android:layout_height="@dimen/icon_size_medium"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_logo"
                    android:src="@drawable/img_logo_mark"
                    app:tint="@color/white" />
            </FrameLayout>

            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:gravity="center"
                android:text="@string/login_brand_title"
                android:textAppearance="@style/TextAppearance.DriveTrack.BrandTitle"
                app:lineHeightSp="32" />

            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:gravity="center"
                android:text="@string/login_brand_subtitle"
                android:textAppearance="@style/TextAppearance.DriveTrack.Body"
                app:lineHeightSp="20" />
        </LinearLayout>

        <!-- Login card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/loginCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_40"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="@dimen/elevation_card"
            app:strokeColor="@color/border_card"
            app:strokeWidth="@dimen/stroke_thin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerBrand">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_32">

                <com.example.kendaraanbp1.ui.widget.DTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_heading"
                    android:textAppearance="@style/TextAppearance.DriveTrack.Headline"
                    app:lineHeightSp="32" />

                <com.example.kendaraanbp1.ui.widget.DTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="@string/login_subheading"
                    android:textAppearance="@style/TextAppearance.DriveTrack.Body"
                    app:lineHeightSp="20" />

                <!-- Form -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_32"
                    android:orientation="vertical">

                    <!-- Email field -->
                    <com.example.kendaraanbp1.ui.widget.DTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_label_email"
                        android:textAppearance="@style/TextAppearance.DriveTrack.LabelBold"
                        app:lineHeightSp="16" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/emailInputLayout"
                        style="@style/Widget.DriveTrack.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/spacing_8"
                        app:startIconDrawable="@drawable/ic_mail"
                        app:startIconTint="@color/icon_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:paddingStart="44dp"
                            android:paddingEnd="16dp"
                            android:gravity="start|center_vertical"
                            android:autofillHints="emailAddress"
                            android:hint="@string/login_hint_email"
                            android:inputType="textEmailAddress"
                            android:textAppearance="@style/TextAppearance.DriveTrack.InputText"
                            android:textColorHint="@color/text_placeholder" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password field -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_24"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.example.kendaraanbp1.ui.widget.DTextView
                            android:id="@+id/passwordLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/login_label_password"
                            android:textAppearance="@style/TextAppearance.DriveTrack.LabelBold"
                            app:lineHeightSp="16" />

                        <com.example.kendaraanbp1.ui.widget.DTextView
                            android:id="@+id/forgotPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:text="@string/login_forgot_password"
                            android:textAppearance="@style/TextAppearance.DriveTrack.LinkSmallBold"
                            app:lineHeightSp="16" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/passwordInputLayout"
                        style="@style/Widget.DriveTrack.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/spacing_8"
                        app:endIconDrawable="@drawable/selector_password_toggle"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/icon_secondary"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/icon_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:paddingStart="44dp"
                            android:paddingEnd="44dp"
                            android:gravity="start|center_vertical"
                            android:autofillHints="password"
                            android:hint="@string/login_hint_password"
                            android:inputType="textPassword"
                            android:textAppearance="@style/TextAppearance.DriveTrack.InputText"
                            android:textColorHint="@color/text_placeholder" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginButton"
                        style="@style/Widget.DriveTrack.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_24"
                        android:text="@string/login_cta"
                        app:icon="@drawable/ic_arrow_forward" />
                </LinearLayout>

                <!-- Social divider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="@dimen/stroke_thin"
                        android:layout_weight="1"
                        android:background="@color/border_default" />

                    <com.example.kendaraanbp1.ui.widget.DTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/spacing_16"
                        android:text="@string/login_divider_social"
                        android:textAppearance="@style/TextAppearance.DriveTrack.LabelBold"
                        android:textColor="@color/icon_secondary"
                        app:lineHeightSp="16" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="@dimen/stroke_thin"
                        android:layout_weight="1"
                        android:background="@color/border_default" />
                </LinearLayout>

                <!-- Social buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/googleButton"
                        style="@style/Widget.DriveTrack.Button.Social"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_small"
                        android:layout_weight="1"
                        android:text="@string/login_social_google"
                        app:icon="@drawable/ic_google" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/facebookButton"
                        style="@style/Widget.DriveTrack.Button.Social"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_small"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:layout_weight="1"
                        android:text="@string/login_social_facebook"
                        app:icon="@drawable/ic_facebook" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Footer link -->
        <LinearLayout
            android:id="@+id/footerLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_32"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loginCard">

            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_footer_prefix"
                android:textAppearance="@style/TextAppearance.DriveTrack.Body"
                app:lineHeightSp="20" />

            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_footer_link"
                android:textAppearance="@style/TextAppearance.DriveTrack.LinkMedium"
                app:lineHeightSp="20" />
        </LinearLayout>

        <!-- Trust banner -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_48"
            android:alpha="0.5"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/footerLink">

            <ImageView
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:contentDescription="@string/cd_icon_lock"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/text_primary" />

            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:text="@string/login_trust_banner"
                android:textAppearance="@style/TextAppearance.DriveTrack.Caption"
                app:lineHeightSp="15" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
