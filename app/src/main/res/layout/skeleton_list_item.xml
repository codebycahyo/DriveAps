<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable skeleton row (leading circle + two text lines + trailing block).
     include it 3–5× inside a container, then start R.anim.skeleton_pulse on the
     container while data loads; swap to the real list on success. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_16"
    android:paddingVertical="@dimen/spacing_12">

    <View
        android:id="@+id/skeletonAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/shape_oval_solid"
        android:backgroundTint="@color/skeleton_base"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/skeletonLine1"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_24"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintStart_toEndOf="@id/skeletonAvatar"
        app:layout_constraintEnd_toStartOf="@id/skeletonTrailing"
        app:layout_constraintTop_toTopOf="@id/skeletonAvatar"
        app:layout_constraintWidth_percent="0.5" />

    <View
        android:id="@+id/skeletonLine2"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_8"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintStart_toEndOf="@id/skeletonAvatar"
        app:layout_constraintTop_toBottomOf="@id/skeletonLine1"
        app:layout_constraintWidth_percent="0.32"
        app:layout_constraintHorizontal_bias="0" />

    <View
        android:id="@+id/skeletonTrailing"
        android:layout_width="72dp"
        android:layout_height="16dp"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
