<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <!-- Timeline rail -->
    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="match_parent">

        <View
            android:id="@+id/timelineLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="@color/timeline_divider" />

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/spacing_24"
            android:background="@drawable/bg_timeline_dot" />
    </FrameLayout>

    <!-- Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/surface_white"
        app:cardCornerRadius="@dimen/radius_medium_16"
        app:cardElevation="@dimen/elevation_soft"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border_card_subtle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_20">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="40dp"
                android:background="@drawable/shape_pill_solid"
                android:backgroundTint="@color/surface_highlight">

                <ImageView
                    android:id="@+id/timelineIcon"
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    app:tint="@color/text_primary"
                    tools:src="@drawable/ic_droplet" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.example.kendaraanbp1.ui.widget.DTextView
                    android:id="@+id/timelineTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.DriveTrack.Title20"
                    android:textColor="@color/text_heading_alt"
                    app:lineHeightSp="28"
                    tools:text="Ganti Oli Mesin" />

                <com.example.kendaraanbp1.ui.widget.DTextView
                    android:id="@+id/timelineSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.DriveTrack.Body"
                    android:textColor="@color/text_muted_alt"
                    app:lineHeightSp="20"
                    tools:text="Bengkel Auto2000 Sudirman" />
            </LinearLayout>

            <com.example.kendaraanbp1.ui.widget.DTextView
                android:id="@+id/timelineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_done"
                android:paddingHorizontal="@dimen/spacing_12"
                android:paddingVertical="@dimen/spacing_4"
                android:textAppearance="@style/TextAppearance.DriveTrack.LabelMedium"
                android:textColor="@color/text_muted_alt"
                app:lineHeightSp="16"
                tools:text="Selesai" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_thin"
            android:layout_marginTop="@dimen/spacing_16"
            android:background="@color/timeline_card_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.example.kendaraanbp1.ui.widget.DTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/service_label_date_distance"
                    android:textAppearance="@style/TextAppearance.DriveTrack.LabelMedium"
                    android:textColor="@color/text_muted_alt"
                    app:lineHeightSp="16" />

                <com.example.kendaraanbp1.ui.widget.DTextView
                    android:id="@+id/timelineDateDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:textAppearance="@style/TextAppearance.DriveTrack.Medium14"
                    app:lineHeightSp="20"
                    tools:text="12 Ags 2024 • 18.750 km" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <com.example.kendaraanbp1.ui.widget.DTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/service_label_total_cost"
                    android:textAppearance="@style/TextAppearance.DriveTrack.LabelMedium"
                    android:textColor="@color/text_muted_alt"
                    app:lineHeightSp="16" />

                <com.example.kendaraanbp1.ui.widget.DTextView
                    android:id="@+id/timelineCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:textAppearance="@style/TextAppearance.DriveTrack.StatValue"
                    app:lineHeightSp="24"
                    tools:text="Rp 650.000" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
