<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_50"
    tools:context=".ui.fuelhistory.FuelHistoryFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_20"
            android:paddingTop="@dimen/spacing_96"
            android:paddingBottom="@dimen/spacing_96">

            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fuel_history_title"
                android:textAppearance="@style/TextAppearance.DriveTrack.Headline"
                android:textColor="@color/neutral_900"
                app:lineHeightSp="32" />

            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/fuel_history_subtitle"
                android:textAppearance="@style/TextAppearance.DriveTrack.Body"
                android:textColor="@color/text_placeholder"
                app:lineHeightSp="20" />

            <!-- Hero summary card -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:background="@drawable/bg_hero_card"
                android:elevation="@dimen/elevation_card"
                android:outlineProvider="background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_stat_block"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_16">

                        <com.example.kendaraanbp1.ui.widget.DTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fuel_history_efficiency_label"
                            android:textAppearance="@style/TextAppearance.DriveTrack.StatLabelWhite"
                            app:lineHeightSp="16" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <com.example.kendaraanbp1.ui.widget.DTextView
                                android:id="@+id/efficiencyValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/fuel_history_efficiency_value"
                                android:textAppearance="@style/TextAppearance.DriveTrack.DisplayWhite"
                                app:lineHeightSp="34" />

                            <com.example.kendaraanbp1.ui.widget.DTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_4"
                                android:layout_marginBottom="@dimen/spacing_4"
                                android:text="@string/home_efficiency_unit"
                                android:textAppearance="@style/TextAppearance.DriveTrack.LabelSemiboldWhite"
                                app:lineHeightSp="20" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:background="@drawable/bg_glass_stat_block"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_16">

                        <com.example.kendaraanbp1.ui.widget.DTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fuel_history_expense_label"
                            android:textAppearance="@style/TextAppearance.DriveTrack.StatLabelWhite"
                            app:lineHeightSp="16" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <com.example.kendaraanbp1.ui.widget.DTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_4"
                                android:text="@string/add_fuel_prefix_currency"
                                android:textAppearance="@style/TextAppearance.DriveTrack.LabelSemiboldWhite"
                                app:lineHeightSp="20" />

                            <com.example.kendaraanbp1.ui.widget.DTextView
                                android:id="@+id/totalExpenseValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_4"
                                android:text="@string/fuel_history_expense_value"
                                android:textAppearance="@style/TextAppearance.DriveTrack.DisplayWhite"
                                app:lineHeightSp="34" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Fuel log list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fuelLogList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="3"
                tools:listitem="@layout/item_fuel_log" />

            <ProgressBar
                android:id="@+id/loadingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/spacing_32"
                android:visibility="gone"
                tools:visibility="visible" />

            <include
                android:id="@+id/fuelLogEmptyState"
                layout="@layout/layout_empty_state" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Top app bar -->
    <LinearLayout
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/glass_dock_bg"
        android:elevation="@dimen/elevation_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_12"
        android:paddingEnd="@dimen/spacing_12"
        android:paddingTop="@dimen/spacing_8"
        android:paddingBottom="@dimen/spacing_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/menuButton"
            android:layout_width="@dimen/icon_button_min_size"
            android:layout_height="@dimen/icon_button_min_size"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <com.example.kendaraanbp1.ui.widget.DTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/login_brand_title"
            android:textAppearance="@style/TextAppearance.DriveTrack.BrandTitle"
            app:lineHeightSp="32" />

        <FrameLayout
            android:id="@+id/notificationButton"
            android:layout_width="@dimen/icon_button_min_size"
            android:layout_height="@dimen/icon_button_min_size"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_notifications"
                android:src="@drawable/ic_bell"
                app:tint="@color/text_primary" />
        </FrameLayout>
    </LinearLayout>

    <!-- FAB -->
    <FrameLayout
        android:id="@+id/addFuelFab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="@dimen/spacing_20"
        android:layout_marginBottom="@dimen/spacing_16"
        android:background="@drawable/shape_pill_solid"
        android:backgroundTint="@color/surface_white"
        android:elevation="@dimen/elevation_dock"
        app:layout_constraintBottom_toTopOf="@id/bottomNavInclude"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_add_fuel_entry"
            android:src="@drawable/ic_plus"
            app:tint="@color/brand_blue" />
    </FrameLayout>

    <!-- Bottom nav -->
    <include
        android:id="@+id/bottomNavInclude"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/bottom_nav_margin_horizontal"
        android:layout_marginBottom="@dimen/bottom_nav_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
