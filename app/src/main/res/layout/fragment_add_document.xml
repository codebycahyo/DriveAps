<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    tools:context=".ui.adddocument.AddDocumentFragment">

    <!-- Handle -->
    <View
        android:layout_width="48dp"
        android:layout_height="6dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_12"
        android:background="@drawable/shape_pill_solid"
        android:backgroundTint="@color/handle_bar" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_8"
        android:paddingTop="@dimen/spacing_20">

        <com.example.kendaraanbp1.ui.widget.DTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tambah Dokumen"
            android:textAppearance="@style/TextAppearance.DriveTrack.HeadingSemibold18"
            app:lineHeightSp="24" />

        <FrameLayout
            android:id="@+id/closeButton"
            android:layout_width="@dimen/icon_button_min_size"
            android:layout_height="@dimen/icon_button_min_size"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/shape_pill_solid"
                android:backgroundTint="@color/surface_close_button">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_close"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_secondary" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_thin"
        android:background="@color/border_card" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="550dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <!-- Jenis Dokumen -->
            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jenis Dokumen"
                android:textAppearance="@style/TextAppearance.DriveTrack.Body"
                android:textColor="@color/text_primary"
                app:lineHeightSp="20" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@drawable/bg_input_field_faint">

                <ImageView
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="@dimen/spacing_16"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_file_text"
                    app:tint="@color/border_default" />

                <EditText
                    android:id="@+id/etType"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_48"
                    android:layout_marginEnd="@dimen/spacing_16"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="STNK, BPKB, Pajak, Asuransi"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.DriveTrack.InputText16"
                    android:textColorHint="@color/border_default" />
            </FrameLayout>

            <!-- Nomor Dokumen -->
            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="Nomor Dokumen"
                android:textAppearance="@style/TextAppearance.DriveTrack.Body"
                android:textColor="@color/text_primary"
                app:lineHeightSp="20" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@drawable/bg_input_field_faint">

                <ImageView
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="@dimen/spacing_16"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_file_text"
                    app:tint="@color/border_default" />

                <EditText
                    android:id="@+id/etNumber"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_48"
                    android:layout_marginEnd="@dimen/spacing_16"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="Nomor Seri / Registrasi"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.DriveTrack.InputText16"
                    android:textColorHint="@color/border_default" />
            </FrameLayout>

            <!-- Masa Berlaku -->
            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="Berlaku Sampai"
                android:textAppearance="@style/TextAppearance.DriveTrack.Body"
                android:textColor="@color/text_primary"
                app:lineHeightSp="20" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@drawable/bg_input_field_faint">

                <ImageView
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="@dimen/spacing_16"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/border_default" />

                <EditText
                    android:id="@+id/etExpiryDate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_48"
                    android:layout_marginEnd="@dimen/spacing_16"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="Pilih Tanggal"
                    android:focusable="false"
                    android:clickable="true"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.DriveTrack.InputText16"
                    android:textColorHint="@color/border_default" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_thin"
        android:background="@color/border_card" />

    <!-- Footer CTA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_16">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/Widget.DriveTrack.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/action_save"
            app:cornerRadius="@dimen/radius_pill"
            app:icon="@drawable/ic_check" />
    </LinearLayout>
</LinearLayout>
