<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_white"
    android:clipChildren="false"
    tools:context=".ui.onboarding.OnboardingWelcomeFragment">

    <!-- Atmospheric soft blobs (progressively blurred on API 31+ in the fragment) -->
    <View
        android:id="@+id/blobBlue"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginStart="-64dp"
        android:layout_marginTop="-72dp"
        android:alpha="0.7"
        android:background="@drawable/shape_oval_solid"
        android:backgroundTint="@color/glass_blob_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/blobViolet"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginEnd="-56dp"
        android:layout_marginTop="88dp"
        android:alpha="0.6"
        android:background="@drawable/shape_oval_solid"
        android:backgroundTint="@color/glass_blob_violet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/blobTeal"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginStart="-48dp"
        android:alpha="0.5"
        android:background="@drawable/shape_oval_solid"
        android:backgroundTint="@color/glass_blob_teal"
        app:layout_constraintBottom_toTopOf="@id/bottomDock"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Skip -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/skipButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_8"
        android:paddingHorizontal="@dimen/spacing_16"
        android:text="@string/onboarding_skip"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable hero + copy (keeps the CTA reachable on short screens / landscape) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/bottomDock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skipButton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_24"
            android:paddingTop="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_24">

            <!-- Floating hero -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:clipChildren="false">

                <View
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_onboarding_hero_glow" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/heroImage"
                    android:layout_width="248dp"
                    android:layout_height="248dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_hero_illustration"
                    android:elevation="@dimen/elevation_card"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_onboarding_welcome_hero"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DriveTrack.Rounded24" />
            </FrameLayout>

            <!-- Feature tag -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_32"
                android:background="@drawable/bg_feature_tag_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_16"
                android:paddingVertical="@dimen/spacing_8">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/text_primary" />

                <com.example.kendaraanbp1.ui.widget.DTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:text="@string/onboarding_welcome_tag"
                    android:textAppearance="@style/TextAppearance.DriveTrack.LabelMedium"
                    app:lineHeightSp="16" />
            </LinearLayout>

            <!-- Heading -->
            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/onboarding_welcome_headline"
                android:textAppearance="@style/TextAppearance.DriveTrack.Display"
                app:lineHeightSp="40" />

            <!-- Subtitle -->
            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:gravity="center"
                android:text="@string/onboarding_welcome_body"
                android:textAppearance="@style/TextAppearance.DriveTrack.BodyLarge"
                app:lineHeightSp="24" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom control bar: page indicator + primary CTA -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_24"
        android:paddingTop="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_24"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/dot_size_active"
                android:layout_height="@dimen/dot_size"
                android:background="@drawable/shape_dot_active" />

            <View
                android:layout_width="@dimen/dot_size"
                android:layout_height="@dimen/dot_size"
                android:layout_marginStart="@dimen/spacing_8"
                android:background="@drawable/shape_dot_inactive" />

            <View
                android:layout_width="@dimen/dot_size"
                android:layout_height="@dimen/dot_size"
                android:layout_marginStart="@dimen/spacing_8"
                android:background="@drawable/shape_dot_inactive" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextButton"
            style="@style/Widget.DriveTrack.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/onboarding_cta_next"
            app:cornerRadius="@dimen/radius_button"
            app:icon="@drawable/ic_arrow_forward" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
