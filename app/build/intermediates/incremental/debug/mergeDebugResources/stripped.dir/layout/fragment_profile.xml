<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_50"
    tools:context=".ui.profile.ProfileFragment">

    <LinearLayout
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="69dp"
        android:background="@color/glass_dock_bg"
        android:elevation="@dimen/elevation_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_12"
        android:paddingEnd="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/menuButton"
            android:layout_width="@dimen/icon_button_min_size"
            android:layout_height="@dimen/icon_button_min_size"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/icon_size_medium"
                android:layout_height="@dimen/icon_size_small"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_menu"
                android:src="@drawable/ic_menu"
                app:tint="@color/text_placeholder" />
        </FrameLayout>

        <com.example.kendaraanbp1.ui.widget.DTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/profile_title"
            android:textAppearance="@style/TextAppearance.DriveTrack.BrandTitle"
            android:textSize="20sp"
            app:lineHeightSp="28" />

        <FrameLayout
            android:id="@+id/settingsButton"
            android:layout_width="@dimen/icon_button_min_size"
            android:layout_height="@dimen/icon_button_min_size"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/icon_size_medium"
                android:layout_height="@dimen/icon_size_medium"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_settings"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_placeholder" />
        </FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_128"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topAppBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_20"
            android:paddingTop="@dimen/spacing_16">

            <!-- Profile header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_header"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_24">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/shape_pill_solid"
                    android:backgroundTint="@color/avatar_placeholder_bg"
                    android:elevation="@dimen/elevation_card">

                    <com.example.kendaraanbp1.ui.widget.DTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_avatar"
                        android:text="@string/profile_avatar_initials"
                        android:textAppearance="@style/TextAppearance.DriveTrack.Display"
                        android:textColor="@color/white"
                        app:lineHeightSp="40" />
                </FrameLayout>

                <com.example.kendaraanbp1.ui.widget.DTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="@string/profile_name"
                    android:textAppearance="@style/TextAppearance.DriveTrack.ProfileName"
                    app:lineHeightSp="24" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_car"
                        app:tint="@color/text_placeholder" />

                    <com.example.kendaraanbp1.ui.widget.DTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:text="@string/profile_vehicle_count"
                        android:textAppearance="@style/TextAppearance.DriveTrack.ProfileMeta"
                        app:lineHeightSp="18" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section: Akun -->
            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:paddingHorizontal="@dimen/spacing_4"
                android:text="@string/section_account"
                android:textAppearance="@style/TextAppearance.DriveTrack.SectionHeader"
                app:lineHeightSp="18" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowEditProfile"
                    layout="@layout/item_settings_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    android:background="@color/divider_faint" />

                <include
                    android:id="@+id/rowSecurity"
                    layout="@layout/item_settings_row" />
            </LinearLayout>

            <!-- Section: Aplikasi -->
            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:paddingHorizontal="@dimen/spacing_4"
                android:text="@string/section_app"
                android:textAppearance="@style/TextAppearance.DriveTrack.SectionHeader"
                app:lineHeightSp="18" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowTheme"
                    layout="@layout/item_settings_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    android:background="@color/divider_faint" />

                <include
                    android:id="@+id/rowLanguage"
                    layout="@layout/item_settings_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    android:background="@color/divider_faint" />

                <include
                    android:id="@+id/rowNotifications"
                    layout="@layout/item_settings_row" />
            </LinearLayout>

            <!-- Section: Data -->
            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:paddingHorizontal="@dimen/spacing_4"
                android:text="@string/section_data"
                android:textAppearance="@style/TextAppearance.DriveTrack.SectionHeader"
                app:lineHeightSp="18" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowBackupRestore"
                    layout="@layout/item_settings_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    android:background="@color/divider_faint" />

                <include
                    android:id="@+id/rowExportReport"
                    layout="@layout/item_settings_row" />
            </LinearLayout>

            <!-- Section: Info -->
            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:paddingHorizontal="@dimen/spacing_4"
                android:text="@string/section_info"
                android:textAppearance="@style/TextAppearance.DriveTrack.SectionHeader"
                app:lineHeightSp="18" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowHelp"
                    layout="@layout/item_settings_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    android:background="@color/divider_faint" />

                <include
                    android:id="@+id/rowAbout"
                    layout="@layout/item_settings_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    android:background="@color/divider_faint" />

                <include
                    android:id="@+id/rowPrivacyPolicy"
                    layout="@layout/item_settings_row" />
            </LinearLayout>

            <!-- Logout -->
            <LinearLayout
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="@dimen/spacing_24"
                android:background="@drawable/bg_logout_button"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_log_out"
                    app:tint="@color/text_primary" />

                <com.example.kendaraanbp1.ui.widget.DTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:text="@string/action_logout"
                    android:textAppearance="@style/TextAppearance.DriveTrack.LogoutText"
                    app:lineHeightSp="24" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom nav -->
    <include
        android:id="@+id/bottomNavInclude"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/bottom_nav_margin_horizontal"
        android:layout_marginBottom="@dimen/bottom_nav_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
