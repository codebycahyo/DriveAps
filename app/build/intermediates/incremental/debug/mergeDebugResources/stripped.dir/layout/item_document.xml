<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_doc_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_16">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/shape_oval_solid"
        android:backgroundTint="@color/surface_highlight">

        <ImageView
            android:id="@+id/docIcon"
            android:layout_width="@dimen/icon_size_medium"
            android:layout_height="@dimen/icon_size_medium"
            android:layout_gravity="center"
            android:contentDescription="@null"
            app:tint="@color/text_primary"
            tools:src="@drawable/ic_credit_card" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.example.kendaraanbp1.ui.widget.DTextView
            android:id="@+id/docTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.DriveTrack.CardHeading"
            app:lineHeightSp="20"
            tools:text="STNK" />

        <com.example.kendaraanbp1.ui.widget.DTextView
            android:id="@+id/docSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.DriveTrack.Body"
            app:lineHeightSp="20"
            tools:text="Berlaku s/d: 15 Okt 2024" />
    </LinearLayout>

    <com.example.kendaraanbp1.ui.widget.DTextView
        android:id="@+id/docStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_pill_solid"
        android:gravity="center"
        android:paddingHorizontal="@dimen/spacing_12"
        android:paddingVertical="@dimen/spacing_8"
        android:textAppearance="@style/TextAppearance.DriveTrack.LabelMedium"
        app:lineHeightSp="16"
        tools:backgroundTint="@color/status_amber_bg"
        tools:text="Segera Habis"
        tools:textColor="@color/status_amber_text" />
</LinearLayout>
