<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_white"
    android:clipChildren="false"
    tools:context=".ui.onboarding.OnboardingScanFragment">

    <!-- Atmospheric pastel blobs (depth layer); see fragment_onboarding_welcome.xml for the
         same soft-blur approximation approach. -->
    <View
        android:id="@+id/blobBlue"
        android:layout_width="384dp"
        android:layout_height="384dp"
        android:layout_marginStart="-39dp"
        android:layout_marginTop="-88dp"
        android:alpha="0.7"
        android:background="@drawable/shape_oval_solid"
        android:backgroundTint="@color/glass_blob_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/blobViolet"
        android:layout_width="384dp"
        android:layout_height="384dp"
        android:layout_marginStart="@dimen/spacing_48"
        android:layout_marginTop="177dp"
        android:alpha="0.7"
        android:background="@drawable/shape_oval_solid"
        android:backgroundTint="@color/glass_blob_violet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/blobTeal"
        android:layout_width="384dp"
        android:layout_height="384dp"
        android:layout_marginStart="@dimen/spacing_72"
        android:layout_marginTop="588dp"
        android:alpha="0.7"
        android:background="@drawable/shape_oval_solid"
        android:backgroundTint="@color/glass_blob_teal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Illustration section -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="572">

            <FrameLayout
                android:layout_width="256dp"
                android:layout_height="256dp"
                android:layout_gravity="center"
                tools:ignore="UselessParent">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_glass_circle"
                    android:elevation="@dimen/elevation_card" />

                <!-- Receipt card mock -->
                <androidx.cardview.widget.CardView
                    android:layout_width="109dp"
                    android:layout_height="137dp"
                    android:layout_marginStart="@dimen/spacing_72"
                    android:layout_marginTop="@dimen/spacing_72"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="@dimen/radius_small"
                    app:cardElevation="@dimen/elevation_card"
                    app:cardUseCompatPadding="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_receipt_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_8">

                        <View
                            android:layout_width="78dp"
                            android:layout_height="16dp"
                            android:layout_marginBottom="@dimen/spacing_8"
                            android:background="@drawable/shape_placeholder_line" />

                        <View
                            android:layout_width="59dp"
                            android:layout_height="14dp"
                            android:layout_marginBottom="@dimen/spacing_16"
                            android:background="@drawable/shape_placeholder_line" />

                        <FrameLayout
                            android:layout_width="85dp"
                            android:layout_height="78dp"
                            android:background="@drawable/bg_highlight_box">

                            <ImageView
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:layout_gravity="center"
                                android:contentDescription="@string/cd_icon_receipt_amount"
                                android:src="@drawable/ic_banknote" />
                        </FrameLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Floating camera lens -->
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="@dimen/spacing_128"
                    android:layout_marginTop="152dp"
                    android:background="@drawable/bg_camera_lens"
                    android:elevation="@dimen/elevation_card">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_icon_camera"
                        android:src="@drawable/ic_camera" />
                </FrameLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- Text content section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="192"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_32">

            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_8"
                android:gravity="center"
                android:paddingHorizontal="25dp"
                android:text="@string/onboarding_scan_headline"
                android:textAppearance="@style/TextAppearance.DriveTrack.Display"
                app:lineHeightSp="40" />

            <com.example.kendaraanbp1.ui.widget.DTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_20"
                android:text="@string/onboarding_scan_body"
                android:textAppearance="@style/TextAppearance.DriveTrack.BodyLarge"
                app:lineHeightSp="24" />
        </LinearLayout>

        <!-- Bottom controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="120"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_32">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_24"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/dot_size"
                    android:layout_height="@dimen/dot_size"
                    android:background="@drawable/shape_dot_inactive" />

                <View
                    android:layout_width="@dimen/dot_size_active"
                    android:layout_height="@dimen/dot_size"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:background="@drawable/shape_dot_active" />

                <View
                    android:layout_width="@dimen/dot_size"
                    android:layout_height="@dimen/dot_size"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:background="@drawable/shape_dot_inactive" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextButton"
                style="@style/Widget.DriveTrack.Button.GradientCta"
                android:layout_width="300dp"
                android:layout_height="@dimen/button_height"
                android:text="@string/onboarding_cta_next"
                app:cornerRadius="@dimen/radius_pill"
                app:icon="@drawable/ic_arrow_forward" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
